{
  "name": "ULHPC-sysadmins",
  "version": "0.9.0",
  "author": "UL HPC Team",
  "summary": "Configuration of a single system administrator account (localadmin by default) attached to (potentially) several  users",
  "license": "GPL-3.0",
  "source": "https://github.com/ULHPC/puppet-sysadmins",
  "project_page": "https://github.com/ULHPC/puppet-sysadmins",
  "issues_url": "https://github.com/ULHPC/puppet-sysadmins/issues",
  "dependencies": [
    {
      "name": "puppetlabs-stdlib",
      "version_requirement": ">=4.0.0 <10.0.0"
    },
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 1.2.0 <2.0.0"
    },
    {
      "name": "ULHPC/bash",
      "version_requirement": ">= 1.0.0 <2.0.0"
    },
    {
      "name": "ULHPC/sudo",
      "version_requirement": ">= 1.0.0 <2.0.0"
    },
    {
      "name": "camptocamp/accounts",
      "version_requirement": ">= 2.0.0 <3.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "11",
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "7",
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [
        "7"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "tags": [
    "users",
    "root",
    "localadmin",
    "sudo",
    "ssh"
  ]
}
